# Postgres connection — used by API server and migrations.
# When running via docker-compose, the DATABASE_URL is composed from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below. Override these for
# self-host or hosted deploys; the dev defaults are weak credentials.
DATABASE_URL=postgres://thirdeye:thirdeye@localhost:5432/thirdeye

# Postgres credentials (consumed by docker-compose only)
POSTGRES_USER=thirdeye
POSTGRES_PASSWORD=thirdeye
POSTGRES_DB=thirdeye

# Helius API key — required for /api/helius/* and /api/helius-rpc proxying.
# Get one (free 1M credits/mo) at https://dashboard.helius.dev/api-keys
HELIUS_API_KEY=

# Public instance mode — when true, anonymous-token rate limits are enforced (spec §16)
PUBLIC_INSTANCE_MODE=false

# Helius proxy rate limit (Phase 1) — enforced only when PUBLIC_INSTANCE_MODE=true
# AND X-User-Helius-Key header is NOT present.
HELIUS_PROXY_LIMIT=600
HELIUS_PROXY_WINDOW_SEC=3600

# Wallet Check rate limit (Phase 2) — enforced only when PUBLIC_INSTANCE_MODE=true.
# Cache window in seconds: how long a check result is considered fresh before
# the route re-runs the pipeline.
WALLET_CHECK_LIMIT=120
WALLET_CHECK_WINDOW_SEC=3600
WALLET_CHECK_CACHE_SEC=14400

# Scan Token rate limit (Phase 3) — enforced only when PUBLIC_INSTANCE_MODE=true
# AND X-User-Helius-Key header is NOT present. Cache 5 minutes — supply
# concentration on a fresh launch shifts every minute as snipers exit.
SCAN_TOKEN_LIMIT=60
SCAN_TOKEN_WINDOW_SEC=3600
SCAN_TOKEN_CACHE_SEC=300

# API listen port
PORT=3001

# CORS allowed origin (web app dev URL)
CORS_ORIGIN=http://localhost:3000
