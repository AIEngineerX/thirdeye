# Postgres connection — used by API server and migrations.
# When running via docker-compose, the DATABASE_URL is composed from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below. Override these for
# self-host or hosted deploys; the dev defaults are weak credentials.
DATABASE_URL=postgres://thirdeye:thirdeye@localhost:5432/thirdeye

# Postgres credentials (consumed by docker-compose only)
POSTGRES_USER=thirdeye
POSTGRES_PASSWORD=thirdeye
POSTGRES_DB=thirdeye

# Helius API key — required for /api/helius/* and /api/helius-rpc proxying.
# Get one (free 1M credits/mo) at https://dashboard.helius.dev/api-keys
HELIUS_API_KEY=

# Public instance mode — when true, anonymous-token rate limits are enforced (spec §16)
PUBLIC_INSTANCE_MODE=false

# Helius proxy rate limit (Phase 1) — enforced only when PUBLIC_INSTANCE_MODE=true
# AND X-User-Helius-Key header is NOT present.
HELIUS_PROXY_LIMIT=600
HELIUS_PROXY_WINDOW_SEC=3600

# Wallet Check rate limit (Phase 2) — enforced only when PUBLIC_INSTANCE_MODE=true.
# Cache window in seconds: how long a check result is considered fresh before
# the route re-runs the pipeline.
WALLET_CHECK_LIMIT=120
WALLET_CHECK_WINDOW_SEC=3600
WALLET_CHECK_CACHE_SEC=14400

# Scan Token rate limit (Phase 3) — enforced only when PUBLIC_INSTANCE_MODE=true
# AND X-User-Helius-Key header is NOT present. Cache 5 minutes — supply
# concentration on a fresh launch shifts every minute as snipers exit.
SCAN_TOKEN_LIMIT=60
SCAN_TOKEN_WINDOW_SEC=3600
SCAN_TOKEN_CACHE_SEC=300

# SMART_MONEY tag (Phase 5d) threshold — wallets with realized SOL PnL above
# this over the last 30d earn the SMART_MONEY tag. Tune to your market;
# 50 SOL is the default for memecoin-focused alpha. Lower for blue-chip
# swappers, higher for high-volume bot operators.
SMART_MONEY_MIN_SOL=50

# Helius webhook subscription (Phase 5e). Both undefined-by-design — leave
# unset until you have a public URL. /api/db/watches returns 503 until set.
#
# PUBLIC_BASE_URL: where Helius pushes events. Locally use ngrok-style:
#   PUBLIC_BASE_URL=https://abc123.ngrok-free.app
# Production: your deployed origin.
#
# HELIUS_WEBHOOK_AUTH: shared secret. Generate with `openssl rand -hex 32`
# or any high-entropy random. Set on the Helius webhook (we register it for
# you on first /watches call) and validated on every inbound event. Rotate
# manually by changing this value AND calling Helius's PUT /v0/webhooks/<id>
# with the new authHeader (or recreate the webhook).
PUBLIC_BASE_URL=
HELIUS_WEBHOOK_AUTH=

# API listen port
PORT=3001

# CORS allowed origin (web app dev URL)
CORS_ORIGIN=http://localhost:3000

# Phase 6b — agent engine. The agent loops (discovery, anomaly, morning
# brief, cluster expander) call Anthropic via @anthropic-ai/sdk. Cron-driven
# loops use ANTHROPIC_API_KEY; user-facing endpoints (cluster expander) accept
# X-User-Anthropic-Key as BYOK override.
ANTHROPIC_API_KEY=

# Daily cost ceiling (USD) across all agent_runs in a UTC day. Per-run
# estimated cost is checked against this under a Postgres advisory lock to
# prevent races between concurrent cron firings. Default $25 — with
# summarization + prompt caching active, real days are ~$3-5; this gives
# 5x headroom for spikes (spec §6 line 617).
AGENT_DAILY_COST_USD_CAP=25

# Per-run hard caps (defense-in-depth on top of the daily cap).
AGENT_MAX_TOOL_CALLS_PER_RUN=20
AGENT_MAX_INPUT_TOKENS_PER_RUN=200000

# Optional model overrides. Defaults are pinned in packages/agent/src/models.ts:
#   cheap     = claude-haiku-4-5-20251001
#   reasoning = claude-sonnet-4-6
AGENT_CHEAP_MODEL=
AGENT_REASONING_MODEL=
