{
  "name": "thirdeye",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json && bun --bun tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:api": "bun --bun tsc --noEmit -p tsconfig.json",
    "typecheck:web": "bun --bun tsc --noEmit -p apps/web/tsconfig.json",
    "test": "bun test",
    "dev": "bun --hot run apps/api/src/index.ts",
    "dev:web": "bun --cwd apps/web run dev",
    "migrate": "bun run packages/db/scripts/migrate.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest",
    "@biomejs/biome": "^1.9.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "hono": "^4.12.21"
  }
}
